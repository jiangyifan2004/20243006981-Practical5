<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/municipality_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_accent"
        android:padding="16dp"
        android:textColor="@color/color_text_light"
        android:textSize="24sp" />

    <ImageView
        android:id="@+id/municipality_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:contentDescription="@string/municipality_photo_description"
        android:scaleType="fitCenter" />

    <ScrollView
        android:id="@+id/municipality_info_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/municipality_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/color_text_dark"
            android:textSize="18sp" />

    </ScrollView>

    <Button
        android:id="@+id/visit_site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:minHeight="48dp"
        android:text="@string/visit_site"
        android:textAllCaps="false"
        android:textColor="@color/color_text_light"
        android:textSize="18sp" />

</LinearLayout>
